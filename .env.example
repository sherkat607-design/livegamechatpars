# Copy to .env and fill in. Used by docker-compose.yml and by `npm start`.

# Your domain (for HTTPS with the "https" profile), e.g. chat.example.com
DOMAIN=

# Long random strings. Generate with: openssl rand -base64 48
JWT_SECRET=
POSTGRES_PASSWORD=

# Keep true behind HTTPS. Set false only to test over plain http on a LAN IP.
SECURE_COOKIES=true

# Max attachment size in MB.
MAX_UPLOAD_MB=25

# Optional TURN relay (use with the "turn" profile), e.g. turn:chat.example.com:3478
TURN_URL=
TURN_USERNAME=lgcp
TURN_PASSWORD=

# Origins allowed to call the API from native apps (the Android app uses https://localhost).
CORS_ORIGINS=https://localhost,http://localhost,capacitor://localhost

# --- Running without Docker (npm start) ---
# DATABASE_URL=postgres://user:password@localhost:5432/lgcp   (empty = embedded database in DATA_DIR)
# DATA_DIR=./data
# CLIENT_DIST=./client/dist
# PORT=3000
# ICE_SERVERS=[{"urls":"stun:stun.l.google.com:19302"}]
